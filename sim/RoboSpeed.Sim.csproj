<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Unity 6 が受け付ける文法に留める。新しい構文を誤って使わないための保険 -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RoboSpeed.Sim</RootNamespace>
    <AssemblyName>RoboSpeed.Sim</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Core は Unity 非依存。あとで Assets\Scripts\Core\ にそのまま置く -->
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
