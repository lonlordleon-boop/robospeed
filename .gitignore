# =========================================================================
# git に入れないもの（tools/make-gitignore.mjs が作る・手で直さない）
# =========================================================================

# ---- 別のプロジェクト・大きすぎるもの ----
QuarterTest/
_upload/
scratchpad/

# ---- 機械が作り直せるもの ----
node_modules/
app/node_modules/
app/www/
app/android/
app/ios/
app/node_modules/
*.log

# ---- 鍵とパスワード（保険。本来この中には無い）----
*.jks
*.keystore
*.key
gamedb.php
local.properties
.gradle/
*.local.json

# ---- 絵の元データ 1.4GB ----
